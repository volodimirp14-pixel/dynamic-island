#include <winres.h>
#include "../src/common/Version.h"

1 RT_MANIFEST "Launcher.manifest"
101 RCDATA "../src/common/settings_schema.json"
102 RCDATA "../src/launcher/ui/index.html"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DI_VERSION_MAJOR,DI_VERSION_MINOR,DI_VERSION_PATCH,0
 PRODUCTVERSION DI_VERSION_MAJOR,DI_VERSION_MINOR,DI_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", "Dynamic Island Launcher"
            VALUE "FileVersion", DI_VERSION_STRING_A
            VALUE "ProductName", "Dynamic Island"
            VALUE "ProductVersion", DI_VERSION_STRING_A
            VALUE "OriginalFilename", "DynamicIslandLauncher.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
