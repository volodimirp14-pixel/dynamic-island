#include <winres.h>
#include "../src/common/Version.h"

// Standalone 0.12: program icon (vector source: res/icon/*.svg). Pro: green dot,
// trial: red dot. DI_EDITION_PRO comes from CMake (option DI_PRO).
#if defined(DI_EDITION_PRO) && DI_EDITION_PRO == 0
1 ICON "icon/island-trial.ico"
#else
1 ICON "icon/island-pro.ico"
#endif

1 RT_MANIFEST "DynamicIsland.manifest"
101 RCDATA "../src/common/settings_schema.json"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DI_VERSION_MAJOR,DI_VERSION_MINOR,DI_VERSION_PATCH,0
 PRODUCTVERSION DI_VERSION_MAJOR,DI_VERSION_MINOR,DI_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", "Dynamic Island"
            VALUE "FileVersion", DI_VERSION_STRING_A
            VALUE "ProductName", "Dynamic Island"
            VALUE "ProductVersion", DI_VERSION_STRING_A
            VALUE "OriginalFilename", "DynamicIsland.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
